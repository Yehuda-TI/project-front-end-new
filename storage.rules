rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Aturan penyimpanan foto produk
    // Pola path: product-images/{userId}/{productId}/{fileName}
    match /product-images/{userId}/{productId}/{fileName} {
      
      // Foto produk dapat diakses secara publik oleh seluruh calon pembeli
      allow read: if true;
      
      // Hanya pemilik akun yang dapat mengunggah file foto miliknya
      // Wajib format gambar (image/*) dan ukuran maksimal 5MB
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;
      
      // Hanya pemilik akun yang dapat menghapus file foto miliknya
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
