rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User Profile Document & Sub-collections Rules
    match /users/{userId} {
      // Pembacaan profil publik diizinkan, tetapi penulisan hanya oleh pemilik akun
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Sub-koleksi Wishlist: users/{uid}/wishlist/{productId}
      // Pengguna HANYA boleh membaca dan menulis dokumen wishlist miliknya sendiri
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId);
      }

      // Sub-koleksi Riwayat Chat: users/{uid}/chats/{chatId}/messages/{messageId}
      // Pengguna HANYA boleh membaca dan mengelola riwayat chat percakapan miliknya sendiri
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
    
    // Product Listing Document Rules (Katalog & Produk Tambahan)
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid;
    }
  }
}
