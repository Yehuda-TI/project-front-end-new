rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User Profile Document Rules
    match /users/{userId} {
      // Siapapun dapat membaca profil publik seller
      allow read: if true;
      
      // Pengguna hanya bisa membuat dan mengubah profil miliknya sendiri
      allow create, update: if isOwner(userId);
      
      // Mencegah penghapusan profil oleh sembarang client
      allow delete: if false;
    }
    
    // Product Listing Document Rules
    match /products/{productId} {
      // Siapapun bisa melihat daftar barang di marketplace
      allow read: if true;
      
      // Hanya pengguna yang sudah login yang dapat memasang iklan
      // dan sellerId harus identik dengan UID akun yang sedang login
      allow create: if isAuthenticated() 
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.price > 0
        && request.resource.data.title is string
        && request.resource.data.status in ['available', 'sold'];
      
      // Hanya pemilik barang yang dapat mengubah atau menandai terjual
      allow update: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId;
      
      // Hanya pemilik barang yang dapat menghapus iklan miliknya
      allow delete: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid;
    }
  }
}
